# Copy to .env (git-ignored). Values already set in the environment take precedence.

# --- Firmware build (scripts/load_env.py) ---
# Default "OTA Server URL" baked into the firmware. Point it at your deployed worker's
# /releases/latest endpoint. Leave empty to use the upstream GitHub releases API.
# Note: the device fetches over plain HTTP unless its TLS trust store covers your host.
OTA_SERVER_URL=

# --- OTA worker deploy (tools/ota-worker/deploy.mjs, also used by CI) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional custom domain route for the worker, e.g. ota.example.com/*
# (the zone must exist on the Cloudflare account). Empty = *.workers.dev URL.
OTA_ROUTE_PATTERN=
